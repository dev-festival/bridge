# Safe local defaults. Copy this file to .env and change values as needed.
BRIDGE_APP_NAME=Bridge Surface
BRIDGE_ENVIRONMENT=development
BRIDGE_API_PREFIX=/api/v1
BRIDGE_DEBUG=false
BRIDGE_LOG_LEVEL=INFO
BRIDGE_DATABASE_URL=sqlite:///./bridge_surface.db
BRIDGE_LOCAL_USER_ID=00000000-0000-4000-8000-000000000001
BRIDGE_LOCAL_USER_DISPLAY_NAME=Local User
BRIDGE_LOCAL_USER_PREFERRED_LANGUAGE=en
